# Copier ce fichier vers .env.server sur le serveur. Ne jamais le publier dans Git.
HOSPITAL_PUBLIC_URL=https://hopital.example.com
HOSPITAL_WEB_PORT=3100
HOSPITAL_API_PORT=4100

POSTGRES_DB=hopital_isiro
POSTGRES_USER=hopital_isiro
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

JWT_ACCESS_SECRET=replace-with-at-least-64-random-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-value
TOTP_ENCRYPTION_KEY=replace-with-another-independent-64-character-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Facultatif : 32 octets encodés en Base64URL. Sans cette valeur, une clé stable est dérivée du secret JWT.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:administration@hopitalcentreisiro.online

SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password
