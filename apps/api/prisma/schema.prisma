generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
  RECEPTIONIST
  SECRETARY
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  MEDICAL_BIOLOGIST
  RADIOLOGIST
  SURGEON
  MIDWIFE
  PHARMACIST
  ACCOUNTANT
  STOREKEEPER
  HR
}

enum CustomFieldEntity {
  PATIENT
  STAFF
  APPOINTMENT
  CONSULTATION
  LABORATORY
  HOSPITALIZATION
  INVOICE
  PRESCRIPTION
  PHARMACY_BATCH
  SURGERY
  MATERNITY
  PEDIATRICS
  RADIOLOGY
  SHIFT
  ATTENDANCE
  PAYROLL
  ACCOUNTING
  CARE_VOUCHER
  NURSING_CARE
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum EmergencySeverity {
  CRITICAL
  HIGH
}

enum EmergencyAlertStatus {
  ACTIVE
  RESOLVED
}

enum Sex {
  MALE
  FEMALE
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PatientJourneyStage {
  AWAITING_PAYMENT
  WAITING_DOCTOR
  IN_CONSULTATION
  LABORATORY
  IMAGING
  RETURN_TO_DOCTOR
  HOSPITALIZATION
  COMPLETED
  CANCELLED
}

enum ConsultationStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExamStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  VALIDATED
  CANCELLED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum HospitalizationStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
}

enum PaymentPayer {
  PATIENT
  INSURER
  SPONSOR
}

enum CareVoucherStatus {
  ACTIVE
  SUSPENDED
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum CareVoucherSponsorType {
  COMPANY
  INDIVIDUAL
}

enum VoucherCoverageStatus {
  GUARANTEED
  SETTLED
  CANCELLED
}

enum NursingCareType {
  INJECTION
  INFUSION
  MEDICATION
  DRESSING
  WOUND_CARE
  SAMPLE_COLLECTION
  VITAL_SIGNS
  HYGIENE
  MOBILIZATION
  MONITORING
  OTHER
}

enum NursingCareStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum InsuranceCoverageStatus {
  DRAFT
  GUARANTEED
  REJECTED
  SETTLED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum PrescriptionAvailability {
  INTERNAL
  PARTIAL
  EXTERNAL
  NON_CATALOGUED
}

enum DepartmentReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CLOSED
  REJECTED
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_FULFILLED
  FULFILLED
  REJECTED
  CANCELLED
}

enum RequisitionPriority {
  ROUTINE
  URGENT
  CRITICAL
}

enum InteractionSeverity {
  INFO
  MODERATE
  SEVERE
  CONTRAINDICATED
}

enum InventoryStatus {
  DRAFT
  COUNTING
  RECONCILED
  CANCELLED
}

enum SpecialtyCaseStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  VALIDATED
  CANCELLED
}

enum RadiologyModality {
  CR
  DX
  US
  CT
  MR
  MG
  XA
  OTHER
}

enum RadiologyStudyStatus {
  ORDERED
  SCHEDULED
  ACQUIRED
  REPORTED
  VALIDATED
  CANCELLED
}

enum ShiftStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  SICK
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum PayrollEntryStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum UtilityType {
  ELECTRICITY
  WATER
  INTERNET
}

enum UtilityBillStatus {
  PENDING
  PAID
  CANCELLED
}

enum ArchiveAction {
  ARCHIVED
  RESTORED
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum BillableServiceType {
  CONSULTATION
  LABORATORY
  HOSPITALIZATION
  PHARMACY
  PROCEDURE
  RADIOLOGY
  SURGERY
  MATERNITY
  PEDIATRICS
  BLOOD_BANK
  OTHER
}

enum ClinicalOrderStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  VALIDATED
  CANCELLED
}

enum BloodUnitStatus {
  AVAILABLE
  RESERVED
  TRANSFUSED
  DISCARDED
  EXPIRED
}

enum TransfusionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CareAuthorizationStatus {
  PENDING
  AUTHORIZED
  CONSUMED
  WAIVED
  CANCELLED
}

model User {
  id                        String                     @id @default(uuid())
  username                  String                     @unique
  passwordHash              String
  role                      Role
  additionalRoles           Role[]                     @default([])
  isActive                  Boolean                    @default(true)
  lastActiveAt              DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  doctorProfile             DoctorProfile?
  nurseProfile              NurseProfile?
  secretaryProfile          SecretaryProfile?
  labProfile                LabTechnicianProfile?
  staffProfile              StaffProfile?
  sessions                  AuthSession[]
  createdAppointments       Appointment[]              @relation("AppointmentCreator")
  recordedVitals            VitalSign[]                @relation("VitalRecorder")
  uploadedLabExamDocuments  LabExamDocument[]          @relation("LabExamDocumentUploader")
  issuedInvoices            Invoice[]                  @relation("InvoiceIssuer")
  receivedPayments          Payment[]                  @relation("PaymentReceiver")
  stockMovements            StockMovement[]
  sentMessages              Message[]                  @relation("MessageSender")
  receivedMessages          Message[]                  @relation("MessageReceiver")
  auditLogs                 AuditLog[]
  createdCareAuthorizations CareAuthorization[]        @relation("CareAuthorizationCreator")
  waivedCareAuthorizations  CareAuthorization[]        @relation("CareAuthorizationWaiver")
  createdEmergencyAlerts    EmergencyAlert[]           @relation("EmergencyAlertCreator")
  resolvedEmergencyAlerts   EmergencyAlert[]           @relation("EmergencyAlertResolver")
  createdCustomFields       CustomFieldDefinition[]
  requestedClinicalOrders   ClinicalOrder[]            @relation("ClinicalOrderRequester")
  performedClinicalOrders   ClinicalOrder[]            @relation("ClinicalOrderPerformer")
  prescribedTransfusions    BloodTransfusion[]         @relation("TransfusionPrescriber")
  administeredTransfusions  BloodTransfusion[]         @relation("TransfusionAdministrator")
  createdPurchaseOrders     PurchaseOrder[]
  updatedHospitalProfiles   HospitalProfile[]
  prescriptions             Prescription[]             @relation("PrescriptionPrescriber")
  insuranceCoverages        InsuranceCoverage[]        @relation("CoverageCreator")
  specialtyCases            SpecialtyCase[]            @relation("SpecialtyResponsible")
  radiologyStudies          RadiologyStudy[]           @relation("RadiologyPerformer")
  staffShifts               StaffShift[]               @relation("ShiftEmployee")
  attendanceRecords         AttendanceRecord[]         @relation("AttendanceEmployee")
  payrollEntries            PayrollEntry[]             @relation("PayrollEmployee")
  journalEntries            JournalEntry[]             @relation("JournalCreator")
  inventoryCounts           InventoryCount[]           @relation("InventoryCounter")
  idempotencyRecords        IdempotencyRecord[]
  createdPrintTemplates     PrintTemplate[]            @relation("PrintTemplateCreator")
  updatedPrintTemplates     PrintTemplate[]            @relation("PrintTemplateUpdater")
  createdCareVouchers       CareVoucher[]              @relation("CareVoucherCreator")
  createdVoucherCoverages   VoucherCoverage[]          @relation("VoucherCoverageCreator")
  orderedNursingCare        NursingCare[]              @relation("NursingCareOrderer")
  assignedNursingCare       NursingCare[]              @relation("NursingCareAssignedNurse")
  performedNursingCare      NursingCare[]              @relation("NursingCarePerformer")
  cashClosures              CashClosure[]              @relation("CashClosureUser")
  utilityBills              UtilityBill[]              @relation("UtilityBillCreator")
  archivedPatients          Patient[]                  @relation("PatientArchiver")
  patientArchiveEvents      PatientArchiveEvent[]      @relation("PatientArchiveActor")
  updatedArchivePolicies    ArchivePolicy[]            @relation("ArchivePolicyUpdater")
  clinicalAmendments        PatientClinicalAmendment[] @relation("ClinicalAmendmentAuthor")
  createdDepartmentReports  DepartmentDailyReport[]    @relation("DepartmentReportCreator")
  approvedDepartmentReports DepartmentDailyReport[]    @relation("DepartmentReportApprover")
  requestedRequisitions     InternalRequisition[]      @relation("RequisitionRequester")
  approvedRequisitions      InternalRequisition[]      @relation("RequisitionApprover")
  fulfilledRequisitions     InternalRequisition[]      @relation("RequisitionFulfiller")
  departmentStockMovements  DepartmentStockMovement[]
  emergencyAlertComments    EmergencyAlertComment[]    @relation("EmergencyAlertCommentAuthor")

  @@index([role, isActive])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model DoctorProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  lastName         String
  postName         String?
  firstName        String?
  grade            String?
  specialty        String
  licenseNumber    String?           @unique
  phone            String?
  address          String?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  consultations    Consultation[]
  examRequests     ExamRequest[]     @relation("ExamRequester")
  hospitalizations Hospitalization[]
}

model NurseProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  lastName  String
  postName  String?
  firstName String?
  specialty String?
  phone     String?
  address   String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecretaryProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  lastName       String
  postName       String?
  firstName      String?
  educationLevel String?
  phone          String?
  address        String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LabTechnicianProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  lastName       String
  postName       String?
  firstName      String?
  specialty      String?
  phone          String?
  address        String?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  performedExams ExamRequest[] @relation("ExamPerformer")
  validatedExams ExamRequest[] @relation("ExamValidator")
}

model StaffProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  lastName  String
  postName  String?
  firstName String?
  specialty String?
  grade     String?
  phone     String?
  address   String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Patient {
  id                  String                     @id @default(uuid())
  medicalRecordNumber String                     @unique
  identityKey         String?                    @unique
  lastName            String
  postName            String?
  firstName           String?
  sex                 Sex
  dateOfBirth         DateTime?
  bloodType           String?
  address             String?
  phone               String?
  emergencyContact    String?
  archivedAt          DateTime?
  archiveDepartment   String?
  archiveReason       String?
  retentionUntil      DateTime?
  archivedById        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  appointments        Appointment[]
  consultations       Consultation[]
  vitalSigns          VitalSign[]
  examRequests        ExamRequest[]
  hospitalizations    Hospitalization[]
  invoices            Invoice[]
  careAuthorizations  CareAuthorization[]
  clinicalOrders      ClinicalOrder[]
  insurancePolicies   PatientInsurance[]
  bloodTransfusions   BloodTransfusion[]
  prescriptions       Prescription[]
  specialtyCases      SpecialtyCase[]
  radiologyStudies    RadiologyStudy[]
  careVouchers        CareVoucher[]
  nursingCare         NursingCare[]
  archivedBy          User?                      @relation("PatientArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  archiveEvents       PatientArchiveEvent[]
  clinicalAmendments  PatientClinicalAmendment[]
  emergencyAlerts     EmergencyAlert[]

  @@index([lastName, postName, firstName])
  @@index([phone])
  @@index([archivedAt])
  @@index([archiveDepartment, archivedAt])
}

model PatientArchiveEvent {
  id         String        @id @default(uuid())
  reference  String        @unique
  patientId  String
  action     ArchiveAction
  department String?
  reason     String
  actorId    String?
  occurredAt DateTime      @default(now())
  metadata   Json?
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  actor      User?         @relation("PatientArchiveActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([patientId, occurredAt])
  @@index([action, occurredAt])
  @@index([department, occurredAt])
}

model ArchivePolicy {
  id                     String   @id @default("patient")
  retentionYears         Int      @default(10)
  autoArchiveAfterMonths Int?
  requireReason          Boolean  @default(true)
  updatedById            String?
  updatedAt              DateTime @updatedAt
  updatedBy              User?    @relation("ArchivePolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PatientNumberSequence {
  year      Int @id
  lastValue Int @default(0)
}

model Appointment {
  id                   String              @id @default(uuid())
  patientId            String
  doctorId             String?
  createdById          String
  scheduledAt          DateTime
  service              String
  reason               String?
  status               AppointmentStatus   @default(SCHEDULED)
  journeyStage         PatientJourneyStage @default(AWAITING_PAYMENT)
  journeyUpdatedAt     DateTime            @default(now())
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  doctorAcknowledgedAt DateTime?
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor               DoctorProfile?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  createdBy            User                @relation("AppointmentCreator", fields: [createdById], references: [id])
  consultation         Consultation?
  careAuthorization    CareAuthorization?

  @@index([scheduledAt, status])
  @@index([journeyStage, journeyUpdatedAt])
  @@index([patientId])
  @@index([doctorId, scheduledAt])
}

model Consultation {
  id                String                     @id @default(uuid())
  patientId         String
  doctorId          String
  appointmentId     String?                    @unique
  status            ConsultationStatus         @default(WAITING)
  reason            String
  report            String?
  orientation       String?
  prescription      String?
  certificate       String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  patient           Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor            DoctorProfile              @relation(fields: [doctorId], references: [id])
  appointment       Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  vitalSigns        VitalSign[]
  examRequests      ExamRequest[]
  careAuthorization CareAuthorization?
  prescriptions     Prescription[]
  nursingCare       NursingCare[]
  amendments        PatientClinicalAmendment[]

  @@index([patientId, createdAt])
  @@index([doctorId, status])
}

model VitalSign {
  id             String        @id @default(uuid())
  patientId      String
  consultationId String?
  recordedById   String
  weightKg       Decimal?      @db.Decimal(5, 2)
  heightCm       Decimal?      @db.Decimal(5, 2)
  temperatureC   Decimal?      @db.Decimal(4, 2)
  systolic       Int?
  diastolic      Int?
  pulse          Int?
  oxygenPercent  Int?
  notes          String?
  recordedAt     DateTime      @default(now())
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  recordedBy     User          @relation("VitalRecorder", fields: [recordedById], references: [id])

  @@index([patientId, recordedAt])
}

model ExamRequest {
  id                   String                @id @default(uuid())
  requestGroupId       String                @default(uuid())
  patientId            String
  consultationId       String?
  requestedByDoctorId  String
  validatedByLabTechId String?
  performedByLabTechId String?
  type                 String
  observations         String?
  result               String?
  resultSchema         Json?
  resultData           Json?
  reviewComment        String?
  resultFileKey        String?
  status               ExamStatus            @default(REQUESTED)
  requestedAt          DateTime              @default(now())
  completedAt          DateTime?
  validatedAt          DateTime?
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation         Consultation?         @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  requestedByDoctor    DoctorProfile         @relation("ExamRequester", fields: [requestedByDoctorId], references: [id])
  performedByLabTech   LabTechnicianProfile? @relation("ExamPerformer", fields: [performedByLabTechId], references: [id], onDelete: SetNull)
  validatedByLabTech   LabTechnicianProfile? @relation("ExamValidator", fields: [validatedByLabTechId], references: [id], onDelete: SetNull)
  careAuthorization    CareAuthorization?
  document             LabExamDocument?

  @@index([patientId, requestedAt])
  @@index([requestGroupId, requestedAt])
  @@index([status, requestedAt])
  @@index([performedByLabTechId])
}

model LabExamDocument {
  id            String      @id @default(uuid())
  examRequestId String      @unique
  fileName      String
  mimeType      String
  sizeBytes     Int
  data          Bytes
  uploadedById  String
  uploadedAt    DateTime    @default(now())
  examRequest   ExamRequest @relation(fields: [examRequestId], references: [id], onDelete: Cascade)
  uploadedBy    User        @relation("LabExamDocumentUploader", fields: [uploadedById], references: [id])

  @@index([uploadedById, uploadedAt])
}

model Room {
  id      String  @id @default(uuid())
  code    String  @unique
  name    String
  service String?
  beds    Bed[]
}

model Bed {
  id               String            @id @default(uuid())
  roomId           String
  code             String
  status           BedStatus         @default(AVAILABLE)
  room             Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hospitalizations Hospitalization[]

  @@unique([roomId, code])
  @@index([status])
}

model Hospitalization {
  id                  String                @id @default(uuid())
  patientId           String
  doctorId            String?
  bedId               String
  reason              String
  notes               String?
  status              HospitalizationStatus @default(ACTIVE)
  admittedAt          DateTime              @default(now())
  expectedDischargeAt DateTime?
  dischargedAt        DateTime?
  patient             Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor              DoctorProfile?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  bed                 Bed                   @relation(fields: [bedId], references: [id])
  careAuthorization   CareAuthorization?
  nursingCare         NursingCare[]
  emergencyAlerts     EmergencyAlert[]

  @@index([patientId, status])
  @@index([bedId, status])
}

model Invoice {
  id                String             @id @default(uuid())
  number            String             @unique
  patientId         String
  issuedById        String
  status            InvoiceStatus      @default(DRAFT)
  total             Decimal            @default(0) @db.Decimal(12, 2)
  notes             String?
  issuedAt          DateTime           @default(now())
  dueAt             DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  patient           Patient            @relation(fields: [patientId], references: [id])
  issuedBy          User               @relation("InvoiceIssuer", fields: [issuedById], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  careAuthorization CareAuthorization?
  insuranceClaim    InsuranceClaim?
  insuranceCoverage InsuranceCoverage?
  voucherCoverage   VoucherCoverage?
  prescription      Prescription?

  @@index([patientId, issuedAt])
  @@index([status, issuedAt])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String        @id @default(uuid())
  invoiceId    String
  receivedById String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  payerType    PaymentPayer  @default(PATIENT)
  reference    String?
  paidAt       DateTime      @default(now())
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy   User          @relation("PaymentReceiver", fields: [receivedById], references: [id])

  @@index([invoiceId, paidAt])
}

model CashClosure {
  id             String   @id @default(uuid())
  businessDate   DateTime @unique @db.Date
  closedById     String
  invoiceCount   Int
  paymentCount   Int
  totalBilled    Decimal  @db.Decimal(14, 2)
  totalCollected Decimal  @db.Decimal(14, 2)
  cashTotal      Decimal  @db.Decimal(14, 2)
  mobileTotal    Decimal  @db.Decimal(14, 2)
  bankTotal      Decimal  @db.Decimal(14, 2)
  cardTotal      Decimal  @db.Decimal(14, 2)
  patientTotal   Decimal  @db.Decimal(14, 2)
  insurerTotal   Decimal  @db.Decimal(14, 2)
  sponsorTotal   Decimal  @db.Decimal(14, 2)
  notes          String?
  closedAt       DateTime @default(now())
  closedBy       User     @relation("CashClosureUser", fields: [closedById], references: [id])

  @@index([closedAt])
}

model Medication {
  id                    String                      @id @default(uuid())
  code                  String                      @unique
  name                  String
  form                  String?
  strength              String?
  stockQuantity         Int                         @default(0)
  minimumStock          Int                         @default(5)
  unitPrice             Decimal                     @default(0) @db.Decimal(12, 2)
  isActive              Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  stockMovements        StockMovement[]
  careAuthorizations    CareAuthorization[]
  purchaseOrderItems    PurchaseOrderItem[]
  batches               MedicationBatch[]
  prescriptionItems     PrescriptionItem[]
  interactionAsA        DrugInteraction[]           @relation("InteractionMedicationA")
  interactionAsB        DrugInteraction[]           @relation("InteractionMedicationB")
  inventoryLines        InventoryCountLine[]
  departmentStocks      DepartmentStock[]
  departmentReportItems DepartmentDailyReportItem[]
  requisitionItems      InternalRequisitionItem[]
  departmentMovements   DepartmentStockMovement[]

  @@index([name])
  @@index([stockQuantity])
}

model StockMovement {
  id           String            @id @default(uuid())
  medicationId String
  userId       String
  type         StockMovementType
  quantity     Int
  reason       String
  reference    String?
  batchId      String?
  createdAt    DateTime          @default(now())
  medication   Medication        @relation(fields: [medicationId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  batch        MedicationBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([medicationId, createdAt])
}

model Message {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  sentAt      DateTime            @default(now())
  readAt      DateTime?
  sender      User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
