}

model JournalEntry {
  id          String             @id @default(uuid())
  number      String             @unique
  date        DateTime
  description String
  reference   String?
  status      JournalEntryStatus @default(DRAFT)
  createdById String
  postedAt    DateTime?
  createdAt   DateTime           @default(now())
  createdBy   User               @relation("JournalCreator", fields: [createdById], references: [id])
  lines       JournalLine[]

  @@index([status, date])
}

model JournalLine {
  id          String        @id @default(uuid())
  entryId     String
  accountId   String
  description String?
  debit       Decimal       @default(0) @db.Decimal(12, 2)
  credit      Decimal       @default(0) @db.Decimal(12, 2)
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, entryId])
}

model UtilityBill {
  id          String            @id @default(uuid())
  type        UtilityType
  periodStart DateTime          @db.Date
  provider    String
  reference   String?
  amount      Decimal           @db.Decimal(12, 2)
  dueAt       DateTime?
  paidAt      DateTime?
  status      UtilityBillStatus @default(PENDING)
  notes       String?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   User              @relation("UtilityBillCreator", fields: [createdById], references: [id])

  @@unique([type, periodStart])
  @@index([status, periodStart])
}

model IdempotencyRecord {
  key         String    @id
  userId      String
  method      String
  path        String
  response    Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PatientClinicalAmendment {
  id             String        @id @default(uuid())
  patientId      String
  consultationId String?
  authorId       String
  category       String
  fieldName      String
  previousValue  String?
  newValue       String
  reason         String
  createdAt      DateTime      @default(now())
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  author         User          @relation("ClinicalAmendmentAuthor", fields: [authorId], references: [id])

  @@index([patientId, createdAt])
  @@index([consultationId, createdAt])
  @@index([authorId, createdAt])
}

model DepartmentStock {
  id              String     @id @default(uuid())
  department      String
  medicationId    String
  quantity        Int        @default(0)
  minimumQuantity Int        @default(0)
  updatedAt       DateTime   @updatedAt
  medication      Medication @relation(fields: [medicationId], references: [id])

  @@unique([department, medicationId])
  @@index([department, quantity])
}

model DepartmentStockMovement {
  id               String     @id @default(uuid())
  medicationId     String
  userId           String
  sourceDepartment String?
  targetDepartment String?
  quantity         Int
  reason           String
  reference        String?
  createdAt        DateTime   @default(now())
  medication       Medication @relation(fields: [medicationId], references: [id])
  user             User       @relation(fields: [userId], references: [id])

  @@index([medicationId, createdAt])
  @@index([sourceDepartment, createdAt])
  @@index([targetDepartment, createdAt])
}

model DepartmentDailyReport {
  id            String                      @id @default(uuid())
  reference     String                      @unique
  department    String
  businessDate  DateTime                    @db.Date
  shift         String?
  status        DepartmentReportStatus      @default(DRAFT)
  newAdmissions Int                         @default(0)
  hospitalized  Int                         @default(0)
  ambulatory    Int                         @default(0)
  serviceTotal  Int                         @default(0)
  metrics       Json?
  observations  String?
  createdById   String
  approvedById  String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  createdBy     User                        @relation("DepartmentReportCreator", fields: [createdById], references: [id])
  approvedBy    User?                       @relation("DepartmentReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items         DepartmentDailyReportItem[]

  @@unique([department, businessDate, shift])
  @@index([businessDate, department])
  @@index([status, businessDate])
}

model DepartmentDailyReportItem {
  id               String                @id @default(uuid())
  reportId         String
  medicationId     String?
  itemName         String
  unit             String?
  openingStock     Int                   @default(0)
  receivedQuantity Int                   @default(0)
  pendingOrder     Int                   @default(0)
  usedQuantity     Int                   @default(0)
  returnedQuantity Int                   @default(0)
  lostQuantity     Int                   @default(0)
  closingStock     Int                   @default(0)
  unitCost         Decimal?              @db.Decimal(12, 2)
  observations     String?
  report           DepartmentDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  medication       Medication?           @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([medicationId])
}

model InternalRequisition {
  id            String                    @id @default(uuid())
  reference     String                    @unique
  department    String
  priority      RequisitionPriority       @default(ROUTINE)
  status        RequisitionStatus         @default(DRAFT)
  reason        String
  notes         String?
  requestedById String
  approvedById  String?
  fulfilledById String?
  requestedAt   DateTime                  @default(now())
  approvedAt    DateTime?
  fulfilledAt   DateTime?
  updatedAt     DateTime                  @updatedAt
  requestedBy   User                      @relation("RequisitionRequester", fields: [requestedById], references: [id])
  approvedBy    User?                     @relation("RequisitionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  fulfilledBy   User?                     @relation("RequisitionFulfiller", fields: [fulfilledById], references: [id], onDelete: SetNull)
  items         InternalRequisitionItem[]

  @@index([department, requestedAt])
  @@index([status, requestedAt])
}

model InternalRequisitionItem {
  id                String              @id @default(uuid())
  requisitionId     String
  medicationId      String?
  itemName          String
  unit              String?
  quantityRequested Int
  quantityApproved  Int                 @default(0)
  quantityIssued    Int                 @default(0)
  observations      String?
  requisition       InternalRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  medication        Medication?         @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([requisitionId])
  @@index([medicationId])
}
