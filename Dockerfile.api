FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY apps/api apps/api
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" npm run db:generate
RUN npm run build --workspace @hopital/api

FROM builder AS production-dependencies
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs api && \
    mkdir -p /app/uploads/profiles && \
    chown -R api:nodejs /app/uploads
COPY --from=production-dependencies --chown=api:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=api:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=api:nodejs /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder --chown=api:nodejs /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
USER api
EXPOSE 4000
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy --config apps/api/prisma.config.ts && node apps/api/dist/main.js"]
