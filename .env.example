NODE_ENV=development
POSTGRES_DB=hopital_isiro
POSTGRES_USER=hopital
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://hopital:replace-with-a-strong-database-password@localhost:5432/hopital_isiro?schema=public
API_PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-a-dedicated-32-character-random-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:administration@hopitalcentreisiro.online
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-super-admin-password
DEFAULT_PATIENT_FILE_FEE_CDF=5000
DEFAULT_CONSULTATION_FEE_CDF=0
DEFAULT_LAB_FEE_CDF=15000
DEFAULT_SPECIALIZED_LAB_FEE_CDF=25000
DEFAULT_HOSPITALIZATION_FEE_CDF=50000

# Fuseau horaire hospitalier : Isiro = UTC+2
HOSPITAL_UTC_OFFSET_MINUTES=120
